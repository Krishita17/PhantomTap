{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PhantomTap",
          "informationUri": "https://github.com/Krishita17/PhantomTap",
          "version": "0.1.0",
          "rules": [
            {
              "id": "guessability",
              "name": "guessability",
              "shortDescription": {
                "text": "Information-theoretic guessing-resistance (bits)."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "clonability",
              "name": "clonability",
              "shortDescription": {
                "text": "How easily a credential can be cloned/replayed."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "numbering",
              "name": "numbering",
              "shortDescription": {
                "text": "Predictability of card-number issuance."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "format",
              "name": "format",
              "shortDescription": {
                "text": "Credential format strength (bit width, facility/card space)."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "characterization",
              "name": "characterization",
              "shortDescription": {
                "text": "How cheaply the population can be mapped."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "keys",
              "name": "keys",
              "shortDescription": {
                "text": "Sector key hygiene (default/shared keys)."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "properties": {
        "compositeRiskScore": 75,
        "riskBand": "CRITICAL",
        "deployment": "lobby (fc42)"
      },
      "results": [
        {
          "ruleId": "guessability",
          "level": "error",
          "message": {
            "text": "Credential guessing-resistance: 0.0 bits (TRIVIAL) \u2014 A blind adversary faces ~17.1 bits of guessing to forge a valid credential; one that reasons about structure (locked facility code + bounded 120-wide range at 100.0% density) faces only ~0.0 bits. This deployment therefore **leaks ~17.1 bits** of credential security to a structure-aware attacker."
          },
          "properties": {
            "severity": "critical",
            "subScore": 100,
            "remediation": "Widen the effective key space that survives inference: randomise card numbers across the full field and authenticate the credential so a guessed number alone is worthless."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "lobby (fc42)",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "clonability",
          "level": "error",
          "message": {
            "text": "Card family: UID-only (no authentication) \u2014 Credentials are UID-only low-frequency prox / read-only cards. They carry no secret and can be cloned to a blank in seconds by any reader."
          },
          "properties": {
            "severity": "critical",
            "subScore": 95,
            "remediation": "Replace UID-only prox with a challenge-response smart credential; never authorise access on UID alone."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "lobby (fc42)",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "numbering",
          "level": "error",
          "message": {
            "text": "Numbering scheme: sequential \u2014 Card numbers are issued strictly sequentially. Knowing one valid card lets an assessor predict every neighbour with near certainty."
          },
          "properties": {
            "severity": "critical",
            "subScore": 92,
            "remediation": "Issue card numbers from a cryptographically random, non-guessable pool and decouple them from any physical/temporal issuance order."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "lobby (fc42)",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "format",
          "level": "error",
          "message": {
            "text": "Credential format: H10301-26 (26-bit) \u2014 HID 26-bit, the ubiquitous legacy format. Tiny 8-bit facility code space (0-255) makes facility collisions and guessing trivial. The card-number field is 16 bits (max 65,535), and the facility-code field is 8 bits (max 255)."
          },
          "properties": {
            "severity": "high",
            "subScore": 100,
            "remediation": "Migrate to a high-bit-count, cryptographically authenticated credential (e.g. Seos / DESFire EV2/EV3, iCLASS SE) rather than a static Wiegand format that can be read and replayed."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "lobby (fc42)",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "characterization",
          "level": "error",
          "message": {
            "text": "Attempts-to-characterize \u2014 Guided search characterised 90% of the issued population in 101 reader queries versus ~2,792,790 for brute force (~27,651x fewer attempts). Low attempts-to-characterize is itself a weakness signal."
          },
          "properties": {
            "severity": "high",
            "subScore": 100,
            "remediation": "Randomised numbering and authenticated credentials both raise the query cost of mapping the population."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "lobby (fc42)",
                  "kind": "resource"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "keys",
          "level": "note",
          "message": {
            "text": "Sector keys: not applicable \u2014 UID-only credentials have no sector key material."
          },
          "properties": {
            "severity": "info",
            "subScore": 0,
            "remediation": "n/a"
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "lobby (fc42)",
                  "kind": "resource"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}